<!DOCTYPE html>
<html lang="">
<%- include("_head") %>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

<!-- Header / Top Nav -->
<header class="bg-gray-900 text-gray-100 shadow-md py-4 w-full">
    <div class="max-w-4xl mx-auto flex justify-between items-center px-4">
        <!-- Site Title -->
        <a href="/people" class="text-2xl font-bold hover:underline">
            People Manager
        </a>

        <!-- Right-side navigation -->
        <div class="flex items-center space-x-4">
            <% if (user) { %>
                <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded">
                    Logout
                </a>
                <span class="font-medium">Hello, <%= user.first_name %></span>
            <% } else { %>
                <a href="/people/new" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded">
                    Register
                </a>
                <a href="/login" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded">
                    Login
                </a>
            <% } %>
        </div>
    </div>
    <% if (alert) { %>
        <div id="flash-alert" class="fixed top-4 right-4 max-w-sm w-full p-4 rounded shadow-md
        <%= alert.type === 'success' ? 'bg-green-600' : alert.type === 'error' ? 'bg-red-600' : 'bg-yellow-500' %>
        text-white">
            <% if (alert.title) { %>
                <strong class="block mb-1"><%= alert.title %></strong>
            <% } %>
            <span><%= alert.message %></span>
        </div>
        <script>
            setTimeout(() => {
                const el = document.getElementById('flash-alert');
                if (el) el.style.transition = 'opacity 0.5s ease-out';
                if (el) el.style.opacity = '0';
            }, 3000); // fade after 3 seconds
        </script>
    <% } %>
</header>

<!-- Main content -->
<main class="flex-1 container mx-auto p-4">
    <%- body %>
</main>

<!-- Footer -->
<footer class="bg-gray-800 text-gray-400 py-4 text-center">
    &copy; <%= new Date().getFullYear() %> People Manager
</footer>

</body>
</html>