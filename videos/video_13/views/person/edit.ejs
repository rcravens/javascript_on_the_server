<h1 style="text-align:center;">Edit Person</h1>
<form method="POST" action="/people/<%= person.email %>?_method=PUT" style="width:300px; margin:auto;">
    <label>First Name:</label><br>
    <input type="text" name="first_name" value="<%= person.first_name %>" required><br><br>

    <label>Last Name:</label><br>
    <input type="text" name="last_name" value="<%= person.last_name %>" required><br><br>

    <button type="submit">Update</button>
</form>

<p style="text-align:center;">
    <a href="/people">Back to People</a>
</p>