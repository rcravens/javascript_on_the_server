<form method="POST" action="/people" class="max-w-md mx-auto bg-gray-800 p-6 rounded-lg shadow-lg space-y-4">
    <div>
        <label class="block mb-1 font-semibold" for="first_name">First Name:</label>
        <input class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
               type="text" name="first_name" value="<%= old('first_name') %>" required>
        <% if (error('first_name')) { %>
            <div class="text-red-500 text-sm mt-1"><%= error('first_name') %></div>
        <% } %>
    </div>

    <div>
        <label class="block mb-1 font-semibold" for="last_name">Last Name:</label>
        <input class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
               type="text" name="last_name" value="<%= old('last_name') %>" required>
        <% if (error('last_name')) { %>
            <div class="text-red-500 text-sm mt-1"><%= error('last_name') %></div>
        <% } %>
    </div>

    <div>
        <label class="block mb-1 font-semibold" for="email">Email:</label>
        <input class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
               type="email" name="email" value="<%= old('email') %>" required>
        <% if (error('email')) { %>
            <div class="text-red-500 text-sm mt-1"><%= error('email') %></div>
        <% } %>
    </div>

    <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded" type="submit">
        Create
    </button>
</form>