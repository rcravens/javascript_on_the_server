<h1 class="text-3xl font-bold text-center mb-6">Edit User</h1>

<div class="max-w-md mx-auto bg-gray-800 p-6 rounded-lg shadow-lg">
    <form method="POST" action="/users/<%= user.email %>?_method=PUT" class="space-y-4">

        <div>
            <label class="block mb-1 font-semibold" for="first_name">First Name:</label>
            <input class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
                   type="text"
                   name="first_name"
                   value="<%= user.first_name %>"
                   required>
        </div>

        <div>
            <label class="block mb-1 font-semibold" for="last_name">Last Name:</label>
            <input
                    class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
                    type="text"
                    name="last_name"
                    value="<%= user.last_name %>"
                    required>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded">
            Update
        </button>
    </form>

    <div class="mt-6 text-center">
        <a href="/users" class="inline-block bg-gray-700 hover:bg-gray-600 text-gray-100 font-semibold px-4 py-2 rounded">
            Back to User
        </a>
    </div>
</div>