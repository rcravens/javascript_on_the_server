<h1 class="text-3xl font-bold text-center mb-6">Delete User</h1>

<div class="max-w-md mx-auto bg-gray-800 p-6 rounded-lg shadow-lg text-center">
    <p class="mb-6 text-gray-200">
        Are you sure you want to delete
        <strong class="text-white"><%= user.first_name %> <%= user.last_name %></strong>?
    </p>

    <form method="POST" action="/users/<%= user.email %>?_method=DELETE" class="space-x-4 inline-block">
        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded">
            Yes, Delete
        </button>

        <a href="/users" class="bg-gray-700 hover:bg-gray-600 text-gray-100 font-semibold px-4 py-2 rounded inline-block">
            Cancel
        </a>
    </form>
</div>