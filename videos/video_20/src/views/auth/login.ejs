<h1 class="text-3xl font-bold text-center mb-6">Login</h1>

<div class="max-w-md mx-auto bg-gray-800 p-6 rounded-lg shadow-lg">
    <% if (success) { %>
        <div class="text-green-400 mb-4"><%= success %></div>
    <% } %>

    <form method="POST" action="/login" class="space-y-4">

        <div>
            <label class="block mb-1 font-semibold" for="email">Email:</label>
            <input
                    class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
                    type="email"
                    name="email"
                    value="<%= old('email') %>"
                    required>
            <% if (error('email')) { %>
                <div class="text-red-500 text-sm mt-1"><%= error('email') %></div>
            <% } %>
        </div>

        <div>
            <label class="block mb-1 font-semibold" for="password">Password:</label>
            <input
                    class="w-full px-3 py-2 rounded bg-gray-700 text-gray-100 border border-gray-600"
                    type="password"
                    name="password"
                    required>
            <% if (error('password')) { %>
                <div class="text-red-500 text-sm mt-1"><%= error('password') %></div>
            <% } %>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded">
            Login
        </button>
    </form>
</div>